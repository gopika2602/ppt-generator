# Supabase project settings. Use the publishable key (or legacy anon key) only.
# Never place a Supabase service_role key in a VITE_* variable.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Public canonical app origin used for email confirmation and password reset links.
# Configure this in Vercel and add the URL to Supabase Auth's redirect allow list.
VITE_APP_URL=https://your-peace-slides-domain.example
